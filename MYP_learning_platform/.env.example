NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Persona-interview chat (app/api/persona-chat) — free at console.groq.com,
# no credit card required. Server-only; never exposed to the client.
GROQ_API_KEY=your-groq-key
# Optional — defaults to openai/gpt-oss-20b if unset. Which model ids a
# given account can see varies; check GET api.groq.com/openai/v1/models
# with your key before overriding this.
GROQ_MODEL=openai/gpt-oss-20b
